            "name": "margin",
            "optional": true,
            "rank": 7,
            "value": "number"
        },
        "AAP": {
            "caption": "Correção de erro",
            "default_val": "H",
            "doc": "Nível de correção de erro: L (7%), M (15%), Q (25%), H (30%). Use H quando houver logo; L permite QR mais simples/denso",
